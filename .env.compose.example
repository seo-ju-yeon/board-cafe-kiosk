# Copy to .env.compose and replace all three password values before first startup.
# Both Docker Compose and Spring's compose profile read .env.compose.
# Use plain KEY=value entries without surrounding quotes or shell expansion.
# Database names are fixed to match the current schema-qualified MyBatis queries.

# MariaDB (host port -> container port 3306)
COMPOSE_MARIADB_PORT=3307
COMPOSE_MARIADB_USERNAME=boardwave
COMPOSE_MARIADB_PASSWORD=change-me-mariadb-password
COMPOSE_MARIADB_ROOT_PASSWORD=change-me-mariadb-root-password

# PostgreSQL with pgvector (host port -> container port 5432)
COMPOSE_PGVECTOR_PORT=5433
COMPOSE_PGVECTOR_USERNAME=boardwave
COMPOSE_PGVECTOR_PASSWORD=change-me-pgvector-password
